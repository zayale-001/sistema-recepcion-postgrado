# Copy this file to backend/.env for local use, or configure each value in the API host.
SECRET_KEY=replace_with_a_long_random_secret
INITIAL_ADMIN_SETUP_TOKEN=generate_a_long_random_token_in_render
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
UPLOAD_DIR=/var/data/postgrado-documents
BACKEND_CORS_ORIGINS=["http://localhost:5174","https://your-vercel-domain.vercel.app"]
FRONTEND_URL=https://your-vercel-domain.vercel.app
PASSWORD_RECOVERY_ADMIN_EMAIL=superadmin@example.invalid
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sender@example.com
SMTP_PASSWORD=mail_app_password
SMTP_FROM=sender@example.com
